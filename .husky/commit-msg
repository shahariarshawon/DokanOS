npx --no -- commitlint --edit "$1" || node -e '
  const fs = require("fs");
  const msg = fs.readFileSync(process.argv[1], "utf-8").trim();
  const pattern = /^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_\-\/]+\))?: .{1,100}/;
  if (!pattern.test(msg) && !msg.startsWith("Merge ") && !msg.startsWith("Revert ")) {
    console.error("\x1b[31m[DokanOS Commit Hook Error]\x1b[0m Invalid commit message format: \"" + msg + "\"");
    console.error("  Follow Conventional Commits: <type>(<scope>): <subject>");
    console.error("  Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert");
    console.error("  Example: feat(auth): implement refresh token validation");
    process.exit(1);
  }
' "$1"
