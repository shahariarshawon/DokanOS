# ==============================================================
# DokanOS Production Environment Template (.env.production)
# ==============================================================

# --------------------------------------------------------------
# 1. DOMAIN & INGRESS CONFIGURATION
# --------------------------------------------------------------
DOMAIN_NAME="dokanos.com"
ACME_EMAIL="admin@dokanos.com"

# --------------------------------------------------------------
# 2. NESTJS BACKEND API (apps/api/.env)
# --------------------------------------------------------------
NODE_ENV="production"
PORT=4000

# NeonDB PostgreSQL with pgvector (SSL required, connection pooler)
DATABASE_URL="postgresql://neondb_owner:<DB_PASSWORD>@ep-empty-block.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Strong JWT Secrets (Generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET="<SECURE_RANDOM_ACCESS_TOKEN_SECRET_MIN_64_CHARS>"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="<SECURE_RANDOM_REFRESH_TOKEN_SECRET_MIN_64_CHARS>"
JWT_REFRESH_EXPIRES_IN="7d"

# Payment Gateway - Stripe
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Payment Gateway - SSLCommerz (Live Merchant Credentials)
SSLCOMMERZ_STORE_ID="your_live_store_id"
SSLCOMMERZ_STORE_PASSWORD="your_live_store_password"
SSLCOMMERZ_IS_LIVE="true"

# AI Microservice Internal Communication
AI_SERVICE_URL="http://ai-service:8000"
AI_INTERNAL_KEY="<RANDOM_HEX_SECRET_MATCHING_AI_SERVICE>"

# Object Storage (Supabase S3 / R2)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
SUPABASE_STORAGE_BUCKET="product-images"

# Redis Cache
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD="<SECURE_RANDOM_REDIS_PASSWORD>"

# --------------------------------------------------------------
# 3. FASTAPI AI SERVICE (apps/ai-service/.env)
# --------------------------------------------------------------
APP_NAME="DokanOS AI Service"
VERSION="1.0.0"
ENVIRONMENT="production"
PORT=8000
HOST="0.0.0.0"

# NeonDB Database (matches backend)
# DATABASE_URL same as above

# LLM Providers
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-1.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Internal Security
INTERNAL_API_KEY="<RANDOM_HEX_SECRET_MATCHING_API>"

# --------------------------------------------------------------
# 4. NEXT.JS WEB CLIENT (apps/web/.env)
# --------------------------------------------------------------
NEXT_PUBLIC_API_URL="https://dokanos.com/api/v1"
