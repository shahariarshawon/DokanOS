{
  "info": {
    "_postman_id": "dokanos-api-collection-v1",
    "name": "DokanOS Marketplace API Collection",
    "description": "Enterprise-grade API test collection for DokanOS multi-vendor marketplace platform. Includes complete coverage for Auth, Users, Products, Orders, Payments, AI RAG & Embeddings, and Real-time Analytics & BI.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication & Users",
      "item": [
        {
          "name": "Register New Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer.test@dokanos.dev\",\n  \"password\": \"SecurePass123!\",\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Smith\",\n  \"role\": \"CUSTOMER\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.environment.set(\"jwt_token\", jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"seller@dokanos.dev\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 201 OK\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Tokens returned\", function () {",
                  "    pm.expect(jsonData).to.have.property('accessToken');",
                  "});",
                  "if (jsonData.accessToken) {",
                  "    pm.environment.set(\"jwt_token\", jsonData.accessToken);",
                  "    pm.environment.set(\"seller_jwt_token\", jsonData.accessToken);",
                  "}",
                  "if (jsonData.refreshToken) {",
                  "    pm.environment.set(\"refresh_token\", jsonData.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Token refreshed successfully\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": {
              "raw": "{{base_url}}/users/profile",
              "host": ["{{base_url}}"],
              "path": ["users", "profile"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Products API",
      "item": [
        {
          "name": "List All Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (Array.isArray(jsonData) && jsonData.length > 0) {",
                  "    pm.environment.set(\"product_id\", jsonData[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Search & Filter Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?search=MacBook&minPrice=1000",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                { "key": "search", "value": "MacBook" },
                { "key": "minPrice", "value": "1000" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Search returns matching products\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["products", "{{product_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Product details retrieved\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create Product (Seller Auth)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{seller_jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dell XPS 15 OLED Laptop\",\n  \"description\": \"Intel Core i9 14-core processor, 32GB DDR5, 1TB SSD, 3.5K OLED touchscreen display.\",\n  \"price\": 2199.00,\n  \"stock\": 15,\n  \"sku\": \"DELL-XPS15-OLED-01\",\n  \"category\": \"Laptops & Tech\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/products",
              "host": ["{{base_url}}"],
              "path": ["products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created or 403 Forbidden\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 401, 403]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Orders API",
      "item": [
        {
          "name": "Create Order from Cart",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": {\n    \"fullName\": \"David Warner\",\n    \"street\": \"123 Market St\",\n    \"city\": \"San Francisco\",\n    \"state\": \"CA\",\n    \"postalCode\": \"94105\",\n    \"country\": \"USA\"\n  },\n  \"paymentMethod\": \"STRIPE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders",
              "host": ["{{base_url}}"],
              "path": ["orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Order creation handled\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 400, 401]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List User Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": {
              "raw": "{{base_url}}/orders",
              "host": ["{{base_url}}"],
              "path": ["orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Orders list retrieved\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 401]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Order Status (Seller / Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{seller_jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SHIPPED\",\n  \"trackingNumber\": \"TRK-984021984\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["orders", "{{order_id}}", "status"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Order status update processed\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 401, 403, 404]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "AI Services API",
      "item": [
        {
          "name": "Shopping Assistant RAG Chat",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Suggest a high performance laptop for software engineering and machine learning under $3500\",\n  \"conversationHistory\": []\n}"
            },
            "url": {
              "raw": "{{base_url}}/ai/chat",
              "host": ["{{base_url}}"],
              "path": ["ai", "chat"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"AI assistant returns response or fallback\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Contains message text\", function () {",
                  "    pm.expect(jsonData).to.have.property('response');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "AI Product Recommendations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/ai/recommendations/{{product_id}}?limit=4",
              "host": ["{{base_url}}"],
              "path": ["ai", "recommendations", "{{product_id}}"],
              "query": [{ "key": "limit", "value": "4" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Recommendations returned\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "AI Seller Copywriting Generator",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{seller_jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Mechanical Keyboard with Gateron Oil King Switches\",\n  \"features\": [\"Hot swappable\", \"Wireless 2.4G & BT\", \"CNC Aluminum\", \"RGB South-facing\"],\n  \"tone\": \"premium\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/ai/copywrite",
              "host": ["{{base_url}}"],
              "path": ["ai", "copywrite"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Generated marketing copy returned\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 401]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "FastAPI Vector Search (Direct Service)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{ai_service_url}}/search?query=headphones&top_k=5",
              "host": ["{{ai_service_url}}"],
              "path": ["search"],
              "query": [
                { "key": "query", "value": "headphones" },
                { "key": "top_k", "value": "5" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Direct pgvector response\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 502, 503]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Analytics & Business Intelligence API",
      "item": [
        {
          "name": "Seller BI Dashboard Telemetry",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{seller_jwt_token}}" }],
            "url": {
              "raw": "{{base_url}}/analytics/seller/dashboard?timeRange=30d",
              "host": ["{{base_url}}"],
              "path": ["analytics", "seller", "dashboard"],
              "query": [{ "key": "timeRange", "value": "30d" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK or 401 Unauthorized\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 401]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.have.property('metrics');",
                  "    pm.expect(data.metrics).to.have.property('totalSales');",
                  "    pm.expect(data.metrics).to.have.property('netRevenue');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Admin Platform Intelligence",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_jwt_token}}" }],
            "url": {
              "raw": "{{base_url}}/analytics/admin/intelligence?timeRange=30d",
              "host": ["{{base_url}}"],
              "path": ["analytics", "admin", "intelligence"],
              "query": [{ "key": "timeRange", "value": "30d" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK or 401 Unauthorized\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 401]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Ingest Telemetry Event",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"PRODUCT_VIEW\",\n  \"productId\": \"{{product_id}}\",\n  \"metadata\": {\n    \"userAgent\": \"PostmanRuntime/7.36.0\",\n    \"referrer\": \"catalog\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/analytics/events",
              "host": ["{{base_url}}"],
              "path": ["analytics", "events"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Telemetry ingestion accepted\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
